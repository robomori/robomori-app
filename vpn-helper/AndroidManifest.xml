<?xml version="1.0" encoding="utf-8"?>
<!-- Robomori's VPN helper: carries every app's TCP traffic to Robomori's Network tab. Built by build.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.robomori.helper">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="@string/app_name" android:icon="@drawable/app_icon" android:allowBackup="false"
        android:extractNativeLibs="true">
        <!-- Only adb's shell holds DUMP among the senders, so no app on the device can turn the VPN on. -->
        <receiver android:name=".Starter" android:exported="true" android:permission="android.permission.DUMP" />
        <service android:name=".InspectionVpn" android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE" android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Sends the device's network traffic to Robomori on the computer it is connected to, for inspection." />
        </service>
    </application>
</manifest>
